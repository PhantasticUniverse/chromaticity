#
# Per docs/43-development-standards.md Sec.12.6.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.rs]
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
trim_trailing_whitespace = true
max_line_length = off

[Makefile]
indent_style = tab

[*.{glsl,frag,vert,wgsl}]
indent_size = 4

[{*.toml,Cargo.toml,rust-toolchain.toml}]
indent_size = 4
