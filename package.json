{
  "name": "@chromaticity/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Chromaticity desktop application (Tauri 2 + Svelte 5 + TypeScript per ADR-018).",
  "license": "LicenseRef-Chromaticity-Proprietary",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "tsc": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "tauri": "tauri",
    "commitlint": "commitlint --edit",
    "commitlint:last": "commitlint --from=HEAD~1 --to=HEAD --verbose",
    "commitlint:last-2": "commitlint --from=HEAD~2 --to=HEAD --verbose",
    "commitlint:ci": "commitlint --from=${COMMITLINT_FROM:-origin/main} --to=${COMMITLINT_TO:-HEAD} --verbose",
    "format:check": "prettier --check \"**/*.{md,ts,tsx,js,jsx,mjs,cjs,svelte,css,yml,yaml,json}\"",
    "format:fix": "prettier --write \"**/*.{md,ts,tsx,js,jsx,mjs,cjs,svelte,css,yml,yaml,json}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@tauri-apps/api": "^2",
    "codemirror": "^6.0.2",
    "svelte": "^5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@commitlint/types": "^19.5.0",
    "@eslint/js": "^9",
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^20",
    "eslint": "^9",
    "eslint-plugin-import": "^2.31",
    "eslint-plugin-svelte": "^3",
    "globals": "^16",
    "jsdom": "^29.0.2",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3",
    "svelte-check": "^4",
    "svelte-eslint-parser": "^1",
    "typescript": "^5.6",
    "typescript-eslint": "^8",
    "vite": "^6",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
