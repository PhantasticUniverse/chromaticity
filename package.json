{
  "name": "@chromaticity/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Chromaticity desktop application (Tauri 2 + Svelte 5 + TypeScript per ADR-018).",
  "license": "LicenseRef-Chromaticity-Proprietary",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tsc": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "tauri": "tauri",
    "commitlint": "commitlint --edit",
    "commitlint:last": "commitlint --from=HEAD~1 --to=HEAD --verbose",
    "commitlint:ci": "commitlint --from=${COMMITLINT_FROM:-origin/main} --to=${COMMITLINT_TO:-HEAD} --verbose",
    "format:check": "prettier --check \"**/*.{md,ts,tsx,js,jsx,mjs,cjs,svelte,css,yml,yaml,json}\"",
    "format:fix": "prettier --write \"**/*.{md,ts,tsx,js,jsx,mjs,cjs,svelte,css,yml,yaml,json}\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "svelte": "^5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@commitlint/types": "^19.5.0",
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "^2",
    "@types/node": "^20",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3",
    "svelte-check": "^4",
    "typescript": "^5.6",
    "vite": "^6"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
