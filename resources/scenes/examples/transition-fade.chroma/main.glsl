#version 450

layout(location = 0) in vec2 uv;
layout(location = 0) out vec4 fragColor;

layout(set = 0, binding = 0) uniform Uniforms {
    vec4 chroma_Time;
    vec4 chroma_Resolution;
    vec4 syn_BPM;
    vec4 chroma_AudioRMS;
    vec4 chroma_AudioPeak;
    vec4 chroma_AudioFFT[2];
    vec4 chroma_Ctrl0;
    vec4 chroma_Ctrl1;
    vec4 chroma_Ctrl2;
    vec4 chroma_Ctrl3;
};

vec3 palette(float t, vec3 a, vec3 b, vec3 c, vec3 d) {
    return a + b * cos(6.2831853 * (c * t + d));
}
void main() {
    float t = chroma_Time.x;
    float blend = smoothstep(0.2, 0.8, uv.x + 0.2 * sin(t));
    vec3 a = vec3(0.12, 0.22, 0.48);
    vec3 b = vec3(0.95, 0.52, 0.22);
    fragColor = vec4(mix(a, b, blend) * (0.8 + 0.2 * syn_BPM.w), 1.0);
}
