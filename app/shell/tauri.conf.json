{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chromaticity",
  "version": "0.0.0",
  "identifier": "app.chromaticity.desktop",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run tsc && npm run check && npm run build:bundle"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chromaticity",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://staging.chromaticity.dev/updates/{{target}}/{{current_version}}"],
      "pubkey": "PLACEHOLDER-PUBKEY-REPLACE-AT-PRODUCTION-CERT-WIRING-PER-ADR-014"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "resources": {
      "../../engine/scene/tests/fixtures/scenes/library/demo-kaleido.chroma/scene.json": "scenes/library/demo-kaleido.chroma/scene.json",
      "../../engine/scene/tests/fixtures/scenes/library/demo-spectrum.chroma/scene.json": "scenes/library/demo-spectrum.chroma/scene.json",
      "../../engine/scene/tests/fixtures/scenes/library/demo-text.chroma/scene.json": "scenes/library/demo-text.chroma/scene.json",
      "../../engine/scene/tests/fixtures/scenes/library/README.md": "scenes/library/README.md",
      "../../engine/scene/tests/fixtures/scenes/welcome/README.md": "scenes/welcome/README.md",
      "../../engine/scene/tests/fixtures/scenes/welcome/welcome.chroma/scene.json": "scenes/welcome/welcome.chroma/scene.json",
      "../../engine/scene/tests/fixtures/scenes/welcome/controls-tour.chroma/scene.json": "scenes/welcome/controls-tour.chroma/scene.json",
      "../../engine/scene/tests/fixtures/scenes/welcome/first-cue.chroma/scene.json": "scenes/welcome/first-cue.chroma/scene.json",
      "../../engine/scene/tests/fixtures/scenes/welcome/quick-start.chroma/scene.json": "scenes/welcome/quick-start.chroma/scene.json",
      "../../engine/scene/tests/fixtures/scenes/examples/README.md": "scenes/examples/README.md",
      "../../engine/scene/tests/fixtures/scenes/examples/audio-reactive-demo.chroma/scene.json": "scenes/examples/audio-reactive-demo.chroma/scene.json",
      "../../engine/scene/tests/fixtures/scenes/examples/bass-pulse.chroma/scene.json": "scenes/examples/bass-pulse.chroma/scene.json",
      "../../engine/scene/tests/fixtures/scenes/examples/four-band-reactive.chroma/scene.json": "scenes/examples/four-band-reactive.chroma/scene.json",
      "../../engine/scene/tests/fixtures/scenes/examples/hotkey-cycle.chroma/scene.json": "scenes/examples/hotkey-cycle.chroma/scene.json",
      "../../engine/scene/tests/fixtures/scenes/examples/osc-grid.chroma/scene.json": "scenes/examples/osc-grid.chroma/scene.json",
      "../../engine/scene/tests/fixtures/scenes/examples/osc-listener.chroma/scene.json": "scenes/examples/osc-listener.chroma/scene.json",
      "../../engine/scene/tests/fixtures/scenes/examples/transition-cut.chroma/scene.json": "scenes/examples/transition-cut.chroma/scene.json",
      "../../engine/scene/tests/fixtures/scenes/examples/transition-fade.chroma/scene.json": "scenes/examples/transition-fade.chroma/scene.json",
      "../../engine/scene/tests/fixtures/scenes/examples/uniform-palette.chroma/scene.json": "scenes/examples/uniform-palette.chroma/scene.json",
      "../../engine/scene/tests/fixtures/scenes/shadertoy-fixtures/README.md": "scenes/shadertoy-fixtures/README.md",
      "../../dist/help/index.html": "help/index.html",
      "../../dist/help/about.html": "help/about.html",
      "../../dist/help/hotkeys-reference.html": "help/hotkeys-reference.html",
      "../../dist/help/osc-routes.html": "help/osc-routes.html",
      "../../dist/help/chroma-uniforms.html": "help/chroma-uniforms.html",
      "../../dist/help/audio-reactivity.html": "help/audio-reactivity.html",
      "../../dist/help/perform-mode.html": "help/perform-mode.html",
      "../../dist/help/scene-workflow.html": "help/scene-workflow.html",
      "../../dist/help/library-workflow.html": "help/library-workflow.html",
      "../../dist/help/settings-reference.html": "help/settings-reference.html",
      "../../dist/help/import-shadertoy.html": "help/import-shadertoy.html",
      "../../dist/help/404.html": "help/404.html",
      "../../dist/help/sitemap.xml": "help/sitemap.xml",
      "../../dist/help/sitemap.xml.gz": "help/sitemap.xml.gz",
      "../../dist/help/assets": "help/assets",
      "../../dist/help/search": "help/search"
    }
  }
}
